	<string>Familiar connects to your Ray-Ban Meta glasses.</string>
	<key>NSCameraUsageDescription</key>
	<string>Familiar uses the camera to find the faces of people who agreed to be recognized.</string>
	<key>NSContactsUsageDescription</key>
	<string>Familiar saves people who agreed to be remembered as contacts and removes them when you ask.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Familiar can stream video from your glasses over Wi-Fi.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Familiar notes where you met someone.</string>
	<key>NFCReaderUsageDescription</key>
	<string>Familiar reads an NFC tag so a person can introduce themselves on this phone.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Familiar listens for your commands and for a person saying yes to being remembered.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Familiar transcribes speech on this phone to hear commands and consent.</string>
