// Copy to Secrets.xcconfig (git-ignored) and fill in. Empty values mean "not configured".
// Slashes in URLs must be written as $()/ so xcconfig does not treat // as a comment.
ELEVENLABS_API_KEY =
ELEVENLABS_VOICE_ID =
ELEVENLABS_AGENT_ID =
// Optional TTS model; empty = eleven_v4_turbo (matches the dashboard agent). eleven_flash_v2_5 is faster.
ELEVENLABS_MODEL_ID =
META_MODEL_API_KEY =
// Optional: any OpenAI-compatible vision endpoint. Empty = Meta Model API (muse-spark-1.3) with the key above.
VISION_API_URL =
VISION_API_KEY =
VISION_MODEL =
MODAL_EMBED_URL =
MODAL_KEY =
MODAL_SECRET =
// SerpApi (serpapi.com) key for "Poyo, look up …" quick facts. Empty = search is off; everything else still works.
SERPAPI_KEY =
